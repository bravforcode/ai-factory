# ============================================
# AI Agent Starter - Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys.
# DO NOT COMMIT .env TO GIT!
# ============================================

# -------- LLM Provider (choose ONE or more) --------

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Google Gemini (FREE tier available) - https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...your-key-here

# -------- LLM Selection --------

# Which provider to use: openai | anthropic | google
LLM_PROVIDER=openai

# Model name (depends on provider)
# OpenAI options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Anthropic options: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Google options: gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gpt-4o-mini

# -------- Agent Configuration --------

# Max iterations per conversation (default 10)
AGENT_MAX_ITERATIONS=10

# LLM temperature: 0 = deterministic, 1 = creative
# Recommended: 0.3 for CS agents, 0.7 for general, 0.9 for creative
AGENT_TEMPERATURE=0.7

# System prompt file (relative path)
# Leave blank to use default
# AGENT_SYSTEM_PROMPT=./prompts/system-prompt.md

# Verbose logging (true/false)
AGENT_VERBOSE=true

# -------- Memory --------

# Where to persist conversation memory
MEMORY_FILE=./memory.json

# Max tokens in context window (will trim older messages)
MEMORY_MAX_TOKENS=8000

# -------- Tools Configuration --------

# DuckDuckGo (web_search) - no API key needed
# Just install: pip install duckduckgo-search

# SerpAPI (alternative web search) - https://serpapi.com/
# SERPAPI_KEY=your-key-here

# -------- Email Tool (send_email) --------

# Gmail SMTP (recommended for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# Other providers:
# Mailgun: smtp.mailgun.org
# SendGrid: smtp.sendgrid.net
# Outlook: smtp-mail.outlook.com

# -------- Optional: Rate Limiting --------

# Max API calls per minute (0 = unlimited)
RATE_LIMIT_PER_MINUTE=0

# -------- Optional: Logging --------

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file (empty = stdout)
LOG_FILE=

# -------- Advanced --------

# HTTP proxy if needed
# HTTP_PROXY=http://proxy.example.com:8080

# Custom API base URLs (for self-hosted or proxy services)
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_BASE=https://api.anthropic.com
