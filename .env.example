# =============================================================================
# .env.example — TEMPLATE for environment variables
# DO NOT commit a .env file with real values. This is the structure only.
# Copy this to .env (which is .gitignore'd) and fill in real values locally.
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe API keys
# Get test keys:    https://dashboard.stripe.com/test/apikeys
# Get live keys:    https://dashboard.stripe.com/apikeys
# Get webhook key:  https://dashboard.stripe.com/webhooks
#
# ⚠️ NEVER commit real keys to git
# ⚠️ NEVER paste keys in chat/email/support tickets
# ⚠️ ROTATE immediately if exposed
# -----------------------------------------------------------------------------

# Test mode (safe for development — fake card 4242 4242 4242 4242)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Live mode (REAL MONEY — be careful)
# STRIPE_SECRET_KEY=sk_live_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# -----------------------------------------------------------------------------
# Vercel deploy
# Get token: https://vercel.com/account/tokens
# -----------------------------------------------------------------------------
VERCEL_TOKEN=replace_me
VERCEL_TEAM_ID=optional_replace_me
VERCEL_PROJECT_NAME=ai-factory-sales-pages

# -----------------------------------------------------------------------------
# Optional: Custom domain (set in Vercel dashboard, not here)
# -----------------------------------------------------------------------------
# CUSTOM_DOMAIN=yourdomain.com
